#!/usr/bin/env python3
"""swordshare — password-protected LAN file server for SwordFM.

Usage: swordshare <path> [--port N] [--no-upload]

Prints one JSON line to stdout once listening:

    {"url":"http://192.168.1.5:8731/","ip":"...","port":8731,
     "password":"492 810","qr":"/tmp/swordshare-xxxx.png"}

then serves until killed. SwordFM parses that line, shows the QR image and
password, and terminates the process when you press Stop.

Why HTTP and not FTP: every current phone browser dropped ftp:// support, so a
QR code containing an FTP link simply fails to open. HTTP opens in the same
browser that scanned the code.

Scope: this is for handing files to your own phone on your own network. It binds
to the LAN address only (never 0.0.0.0), requires a password, and confines every
path to the shared directory. It is not hardened against a hostile attacker who
is already on your network.
"""

import argparse
import hashlib
import hmac
import html
import http.cookies
import json
import mimetypes
import os
import re
import secrets
import shutil
import signal
import socket
import sys
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SESSION_HOURS = 12
MAX_UPLOAD = 8 * 1024 * 1024 * 1024   # 8 GB, i.e. "a phone video will fit"


def die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)


def lan_ip():
    """The address other devices on this network can reach.

    Connecting a UDP socket assigns a local address without sending a packet.
    Resolving the hostname instead usually just yields 127.0.0.1.
    """
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


def human(n):
    if n < 1024:
        return "%d B" % n
    for unit in ("KB", "MB", "GB"):
        n /= 1024.0
        if n < 1024:
            return "%.1f %s" % (n, unit)
    return "%.1f TB" % (n / 1024.0)


