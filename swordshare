def shell(title, body):
    return ("<!DOCTYPE html><html><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'>"
            "<title>%s</title><style>%s</style></head><body>%s</body></html>"
            % (html.escape(title), CSS, body))


def login_page(error=""):
    return shell("SwordFM Share",
                 "<form class=login method=post action='/__login'>"
                 "<h2>SwordFM Share</h2>"
                 "<p>Enter the code shown on the computer</p>%s"
                 "<input type=password name=p autofocus autocomplete=off "
                 "placeholder='code'>"
                 "<button type=submit>Unlock</button></form>"
                 % ("<div class=err>%s</div>" % html.escape(error) if error else ""))


def icon_for(name, isdir):
    if isdir:
        return "&#128193;"
    ext = os.path.splitext(name)[1].lower()
    if ext in (".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".svg", ".heic"):
        return "&#128247;"
    if ext in (".mp4", ".mkv", ".mov", ".avi", ".webm"):
        return "&#127916;"
    if ext in (".mp3", ".flac", ".wav", ".ogg", ".m4a", ".opus"):
        return "&#127925;"
    if ext == ".pdf":
        return "&#128209;"
    if ext in (".zip", ".tar", ".gz", ".xz", ".7z", ".rar", ".zst", ".bz2"):
        return "&#128230;"
    return "&#128196;"


def listing_page(rel, entries, allow_upload, notice=""):
    rows = []
    if rel:
        parent = os.path.dirname(rel.rstrip("/"))
        rows.append("<li><a href='/%s/'><span class=ic>&#8617;</span>"
                    "<span class=nm>..</span></a></li>"
                    % urllib.parse.quote(parent))
    for name, isdir, size in entries:
        href = "/" + urllib.parse.quote(os.path.join(rel, name).lstrip("/"))
        if isdir:
            href += "/"
        rows.append("<li><a href='%s'><span class=ic>%s</span>"
                    "<span class=nm>%s</span><span class=sz>%s</span></a></li>"
                    % (href, icon_for(name, isdir), html.escape(name),
                       "" if isdir else human(size)))

    upload = ""
    if allow_upload:
        upload = ("<form class=up method=post enctype='multipart/form-data' "
                  "action='/__upload?d=%s'>"
                  "<input type=file name=f multiple>"
                  "<button type=submit>Upload to this folder</button></form>"
                  % urllib.parse.quote(rel))

    body = ("<ul>%s</ul>" % "".join(rows)) if rows \
        else "<div class=empty>Empty folder</div>"
    crumb = "/" + rel if rel else "/"
    return shell(crumb,
                 "<header><h1>%s</h1></header><main>%s%s%s</main>"
                 % (html.escape(crumb),
                    "<div class=ok>%s</div>" % html.escape(notice) if notice else "",
                    upload, body))


# ---------------------------------------------------------------- state

class Share:
    def __init__(self, root, password, allow_upload):
        self.root = os.path.realpath(root)
        self.isdir = os.path.isdir(self.root)
        # Sharing a single file still needs a directory to resolve against;
        # `single` then restricts everything else in it to 404.
        self.base = self.root if self.isdir else os.path.dirname(self.root)
        self.single = None if self.isdir else os.path.basename(self.root)
        self.password = password
        self.allow_upload = allow_upload and self.isdir
        self.key = secrets.token_bytes(32)

    def token(self):
        exp = str(int(time.time()) + SESSION_HOURS * 3600)
        return exp + "." + self._sig(exp)

    def _sig(self, exp):
        return hmac.new(self.key, exp.encode(), hashlib.sha256).hexdigest()[:32]

    def valid(self, tok):
        if not tok or "." not in tok:
            return False
        exp, sig = tok.rsplit(".", 1)
        if not hmac.compare_digest(sig, self._sig(exp)):
            return False
        try:
            return int(exp) > time.time()
        except ValueError:
            return False

    def resolve(self, urlpath):
        """Map a URL path onto a real one, or None if it escapes the share.

        realpath() runs before the prefix check so that neither ../ nor a
        symlink pointing outside the shared folder can reach the rest of disk.
        """
        rel = urllib.parse.unquote(urlpath).lstrip("/")
        if "\x00" in rel:
            return None
        full = os.path.realpath(os.path.join(self.base, rel))
        if full != self.base and not full.startswith(self.base + os.sep):
            return None
        if self.single is not None and full not in (self.base, self.root):
            return None
        return full


# ---------------------------------------------------------------- upload

class BodyReader:
    """Buffered view over the request body.

    Line reads and bulk reads have to share one buffer. Mixing
    rfile.readline() with rfile.read() loses whatever a bulk read already
    pulled past a part boundary, which silently drops every file after the
    first in a multi-file upload.
    """

    def __init__(self, rfile, total):
        self.rfile = rfile
        self.left = total          # bytes not yet pulled off the socket
        self.buf = b""

    def _fill(self, n):
        while len(self.buf) < n and self.left > 0:
            chunk = self.rfile.read(min(65536, self.left, n - len(self.buf)))
            if not chunk:
                self.left = 0
                break
            self.left -= len(chunk)
            self.buf += chunk

    def readline(self):
        while b"\n" not in self.buf and self.left > 0:
            self._fill(len(self.buf) + 65536)
        idx = self.buf.find(b"\n")
        if idx < 0:
            line, self.buf = self.buf, b""
            return line
        line, self.buf = self.buf[:idx + 1], self.buf[idx + 1:]
        return line

    def chunk(self, n):
        self._fill(n)
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def empty(self):
        return not self.buf and self.left <= 0


def parse_multipart(rfile, boundary, total, dest, limit=MAX_UPLOAD):
    """Stream a multipart body straight to disk, returning saved filenames.

    Deliberately hand-rolled: `cgi` was removed in Python 3.13, and the stdlib
    alternatives buffer the whole body in memory — which a phone uploading a
    video would not survive.
    """
    if total > limit:
        raise ValueError("That upload is too large.")
    delim = b"--" + boundary
    end = b"\r\n" + delim
    body = BodyReader(rfile, total)
    saved = []

    # Skip to the first boundary.
    while not body.empty():
        line = body.readline()
        if not line or line.rstrip(b"\r\n") == delim:
            break

    while not body.empty():
        name = None
        while not body.empty():                     # part headers
            line = body.readline()
            if not line or line in (b"\r\n", b"\n"):
                break
            m = re.search(rb'filename\*?="([^"]*)"', line)
            if m:
                name = m.group(1).decode("utf-8", "replace")

        sink = None
        out = None
        if name is not None:
            # Basename only: a browser — or a crafted request — may send a path.
            name = os.path.basename(name.replace("\\", "/")).strip()
            if not name or name in (".", ".."):
                name = "upload"
            out = unique_path(dest, name)
            sink = open(out, "wb")

        try:
            buf = b""
            while True:
                chunk = body.chunk(65536)
                if not chunk:
                    if sink:
                        sink.write(buf)
                    buf = b""
                    break
                buf += chunk
                idx = buf.find(end)
                if idx >= 0:
                    if sink:
                        sink.write(buf[:idx])
                    # Push the tail back: it holds the next part's headers.
                    # The CRLF terminating the boundary line goes with it, and
                    # must be dropped — otherwise the next header read sees a
                    # blank line first and treats that part as unnamed.
                    tail = buf[idx + len(end):] + body.buf
                    if tail.startswith(b"\r\n"):
                        tail = tail[2:]
                    body.buf = tail
                    buf = b""
                    break
                # Hold back enough that a boundary split across two chunks
                # is still matched.
                if len(buf) > len(end):
                    if sink:
                        sink.write(buf[:-len(end)])
                    buf = buf[-len(end):]
        finally:
            if sink:
                sink.close()

        if out:
            saved.append(os.path.basename(out))
        if body.buf.startswith(b"--"):               # closing boundary
            break
    return saved


def unique_path(folder, name):
    out = os.path.join(folder, name)
    if not os.path.exists(out):
        return out
    stem, ext = os.path.splitext(name)
    for i in range(2, 10000):
        out = os.path.join(folder, "%s (%d)%s" % (stem, i, ext))
        if not os.path.exists(out):
            return out
    return os.path.join(folder, name + ".dup")


# ---------------------------------------------------------------- handler

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "SwordFM"
    sys_version = ""

    def log_message(self, fmt, *a):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % a))

    # -- helpers

    @property
    def share(self):
        return self.server.share

    def authed(self):
        raw = self.headers.get("Cookie", "")
        try:
            jar = http.cookies.SimpleCookie(raw)
        except http.cookies.CookieError:
            return False
        c = jar.get("sfm")
        return bool(c) and self.share.valid(c.value)

    def send_html(self, body, code=200, cookie=None):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        if cookie:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, to):
        self.send_response(303)
        self.send_header("Location", to)
        self.send_header("Content-Length", "0")
        self.end_headers()

    # -- verbs

    def do_GET(self):
        if not self.authed():
            self.send_html(login_page(), 401)
            return
        path, _, query = self.path.partition("?")
        full = self.share.resolve(path)
        if full is None or not os.path.exists(full):
            self.send_html(shell("Not found",
                                 "<div class=empty>Not found</div>"), 404)
            return
        if os.path.isdir(full):
            self.send_listing(full, path,
                              urllib.parse.parse_qs(query).get("ok", [""])[0])
        else:
            self.send_file(full)

    def do_POST(self):
        path, _, query = self.path.partition("?")
        if path == "/__login":
            self.handle_login()
            return
        if not self.authed():
            self.send_html(login_page(), 401)
            return
        if path == "/__upload":
            self.handle_upload(urllib.parse.parse_qs(query).get("d", [""])[0])
            return
        self.send_html(shell("Not found", "<div class=empty>Not found</div>"), 404)

    def do_HEAD(self):
        self.do_GET()

    # -- actions

    def handle_login(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        body = self.rfile.read(min(n, 4096)).decode("utf-8", "replace")
        given = urllib.parse.parse_qs(body).get("p", [""])[0].strip()
        # Compare without spaces: the password is displayed grouped for
        # readability and people type it either way.
        want = self.share.password.replace(" ", "")
        if hmac.compare_digest(given.replace(" ", ""), want):
            self.send_response(303)
            self.send_header("Location", "/")
            self.send_header("Set-Cookie",
                             "sfm=%s; Path=/; HttpOnly; SameSite=Strict; Max-Age=%d"
                             % (self.share.token(), SESSION_HOURS * 3600))
            self.send_header("Content-Length", "0")
            self.end_headers()
        else:
            time.sleep(0.5)      # take the edge off guessing
            self.send_html(login_page("Wrong code — try again."), 401)

    def handle_upload(self, dest_rel):
        dest = self.share.resolve("/" + dest_rel)
        if not self.share.allow_upload or dest is None or not os.path.isdir(dest):
            self.send_html(shell("No", "<div class=empty>Uploads are off</div>"), 403)
            return
        ctype = self.headers.get("Content-Type", "")
        m = re.search(r'boundary=("?)([^";]+)\1', ctype)
        if not m:
            self.send_html(shell("Bad", "<div class=empty>Bad upload</div>"), 400)
            return
        total = int(self.headers.get("Content-Length", 0) or 0)
        try:
            saved = parse_multipart(self.rfile, m.group(2).encode(), total, dest)
        except (ValueError, OSError) as e:
            self.send_html(shell("Failed",
                                 "<div class=empty>%s</div>" % html.escape(str(e))),
                           400)
            return
        note = "Uploaded %d file%s" % (len(saved), "" if len(saved) == 1 else "s") \
            if saved else "Nothing uploaded"
        self.redirect("/%s?ok=%s" % (urllib.parse.quote(dest_rel.lstrip("/")),
                                     urllib.parse.quote(note)))

    def send_listing(self, full, urlpath, notice):
        rel = os.path.relpath(full, self.share.base)
        rel = "" if rel == "." else rel
        entries = []
        try:
            for name in sorted(os.listdir(full), key=str.lower):
                if name.startswith("."):
                    continue
                if self.share.single is not None and name != self.share.single:
                    continue
                p = os.path.join(full, name)
                try:
                    isdir = os.path.isdir(p)
                    entries.append((name, isdir, 0 if isdir else os.path.getsize(p)))
                except OSError:
                    continue
        except OSError:
            self.send_html(shell("Denied", "<div class=empty>Cannot read</div>"), 403)
            return
        entries.sort(key=lambda e: (not e[1], e[0].lower()))
        self.send_html(listing_page(rel, entries, self.share.allow_upload, notice))

    def send_file(self, full):
        try:
            size = os.path.getsize(full)
            fh = open(full, "rb")
        except OSError:
            self.send_html(shell("Denied", "<div class=empty>Cannot read</div>"), 403)
            return
        ctype = mimetypes.guess_type(full)[0] or "application/octet-stream"
        with fh:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(size))
            self.send_header("Content-Disposition",
                             'inline; filename="%s"'
                             % os.path.basename(full).replace('"', ""))
            self.end_headers()
            if self.command != "HEAD":
                try:
                    shutil.copyfileobj(fh, self.wfile, 64 * 1024)
                except (BrokenPipeError, ConnectionResetError):
                    pass


# ---------------------------------------------------------------- qr

def write_qr(url, out):
    """Render the URL as a PNG. Returns the path, or "" if unavailable."""
    try:
        import qrcode
    except ImportError:
        return ""
    img = qrcode.make(url, box_size=8, border=2)
    img.save(out)
    return out


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("path")
    ap.add_argument("--port", type=int, default=0)
    ap.add_argument("--no-upload", action="store_true")
    args = ap.parse_args()

    if not os.path.exists(args.path):
        die("No such file or folder: %s" % args.path)

    # Six digits, shown as two groups. Long enough that guessing is hopeless
    # over a LAN, short enough to type on a phone without resenting it.
    password = "%03d %03d" % (secrets.randbelow(1000), secrets.randbelow(1000))
    share = Share(args.path, password, not args.no_upload)

    ip = lan_ip()
    try:
        httpd = ThreadingHTTPServer((ip, args.port), Handler)
    except OSError as e:
        die("Could not start the server on %s: %s" % (ip, e))
    httpd.share = share
    httpd.daemon_threads = True
    port = httpd.server_address[1]

    url = "http://%s:%d/" % (ip, port)
    qr = write_qr(url, "/tmp/swordshare-%s.png" % secrets.token_hex(6))

    print(json.dumps({"url": url, "ip": ip, "port": port,
                      "password": password, "qr": qr,
                      "upload": share.allow_upload,
                      "name": os.path.basename(share.root)}), flush=True)

    # SwordFM stops the server with SIGTERM, whose default action skips the
    # cleanup below and leaves the temporary QR image behind. Turning it into
    # an exception lets the normal shutdown path run.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    try:
        httpd.serve_forever()
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        httpd.server_close()
        if qr and os.path.exists(qr):
            os.unlink(qr)


if __name__ == "__main__":
    main()
