#!/bin/bash
# sworddeck — launcher for C++ sworddeck with optional Python fallback
set -o pipefail
export DISPLAY="${DISPLAY:-:0}"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG_DIR="$HOME/.config/animated-wallpaper"
PID_FILE="$CFG_DIR/cyberdeck-cpp.pid"
LOG_FILE="$CFG_DIR/cyberdeck-cpp.log"
GLAVA_PID_FILE="$CFG_DIR/glava.pid"
GLAVA_MODE_FILE="$CFG_DIR/glava.mode"
GLAVA_THEME_FILE="$CFG_DIR/glava.theme"
mkdir -p "$CFG_DIR"

BOTTOM_H=32

screen_size() {
    xrandr --current 2>/dev/null | awk '/\*/{print $1; exit}'
}

# ── GLava state helpers ─────────────────────────────────────────────
GLAVA_MODES=("graph" "bars" "wave" "radial")
GLAVA_THEMES=("cyan" "green" "purple" "red" "rainbow" "sunset")

_glava_get_mode() {
    [ -f "$GLAVA_MODE_FILE" ] && cat "$GLAVA_MODE_FILE" || echo "graph"
}

_glava_get_theme() {
    [ -f "$GLAVA_THEME_FILE" ] && cat "$GLAVA_THEME_FILE" || echo "cyan"
}

_glava_is_running() {
    [ -f "$GLAVA_PID_FILE" ] && kill -0 "$(cat "$GLAVA_PID_FILE")" 2>/dev/null
}

_restart_glava() {
    local mode theme
    mode="$(_glava_get_mode)"
    theme="$(_glava_get_theme)"

    [ -f "$GLAVA_PID_FILE" ] && kill "$(cat "$GLAVA_PID_FILE")" 2>/dev/null && rm -f "$GLAVA_PID_FILE"
    pkill -x glava 2>/dev/null; pkill xwinwrap 2>/dev/null
    sleep 0.2

    if ! command -v glava >/dev/null; then
        return
    fi

    if ! command -v xwinwrap >/dev/null; then
        echo "warning: xwinwrap not installed — glava will NOT be click-through" >&2
    fi

    local res sw sh gw gh gy
    res="$(screen_size)"; res="${res:-1920x1080}"
    sw="${res%x*}"; sh="${res#*x}"
    # glava honours heights above its 50px minimum. Use a ~140px bottom
    # visualizer whose bottom edge meets the top of the 32px dock bar.
    gw=$sw; gh=140; gy=$(( sh - BOTTOM_H - gh ))

    if command -v xwinwrap >/dev/null; then
        # No `--desktop`: it forces glava's window to 0,0 (top-left). Dropping
        # it + explicit setgeometry Y below places the visualizer at the bottom.
        nohup xwinwrap -ov -ni -b -argb -g ${gw}x${gh}+0+${gy} -- \
            glava -m "$mode" -r "setgeometry 0 $gy $gw $gh" \
            > "$CFG_DIR/glava.log" 2>&1 &
    else
        nohup glava -m "$mode" \
            -r "setgeometry 0 $gy $gw $gh" \
            > "$CFG_DIR/glava.log" 2>&1 &
    fi
    echo $! > "$GLAVA_PID_FILE"

    sleep 0.5
    _apply_glava_theme "$theme"
}

_apply_glava_theme() {
    local theme="$1" glsl="$HOME/.config/glava/graph.glsl" bars_glsl="$HOME/.config/glava/bars.glsl" radial_glsl="$HOME/.config/glava/radial.glsl"
    local c1 c2
    case "$theme" in
        cyan)    c1="#00D4FF"; c2="#00FFC8" ;;
        green)   c1="#00FF88"; c2="#88FF00" ;;
        purple)  c1="#c678dd"; c2="#7c3aed" ;;
        red)     c1="#e06c75"; c2="#ff4444" ;;
        rainbow) c1="#ff0000"; c2="#0000ff" ;;
        sunset)  c1="#ff6b35"; c2="#ff006e" ;;
    esac
    for f in "$glsl" "$bars_glsl" "$radial_glsl"; do
        [ -f "$f" ] && sed -i "s|mix(#[0-9A-Fa-f]\{6\}, #[0-9A-Fa-f]\{6\}|mix(${c1}, ${c2}|g" "$f"
    done
}

toggle_glava() {
    if _glava_is_running; then
        kill "$(cat "$GLAVA_PID_FILE")" 2>/dev/null
        rm -f "$GLAVA_PID_FILE"
        pkill -x glava 2>/dev/null
        echo "glava stopped"
    else
        if command -v glava >/dev/null; then
            _restart_glava
            echo "glava started (PID $(cat "$GLAVA_PID_FILE"))"
        else
            echo "glava not installed"
        fi
    fi
}

glava_mode() {
    local new_mode="${1:-}"
    if [ -z "$new_mode" ]; then
        echo "current mode: $(_glava_get_mode) | available: ${GLAVA_MODES[*]}"; return
    fi
    local valid=0; for m in "${GLAVA_MODES[@]}"; do [ "$m" = "$new_mode" ] && valid=1; done
    [ "$valid" -eq 0 ] && echo "invalid mode: $new_mode (available: ${GLAVA_MODES[*]})" && return 1
    echo "$new_mode" > "$GLAVA_MODE_FILE"
    _glava_is_running && _restart_glava && echo "glava mode: $new_mode (restarted)" || echo "glava mode set to $new_mode (will apply on start)"
}

glava_theme() {
    local new_theme="${1:-}"
    if [ -z "$new_theme" ]; then
        echo "current theme: $(_glava_get_theme) | available: ${GLAVA_THEMES[*]}"; return
    fi
    local valid=0; for t in "${GLAVA_THEMES[@]}"; do [ "$t" = "$new_theme" ] && valid=1; done
    [ "$valid" -eq 0 ] && echo "invalid theme: $new_theme (available: ${GLAVA_THEMES[*]})" && return 1
    echo "$new_theme" > "$GLAVA_THEME_FILE"
    _glava_is_running && _restart_glava && echo "glava theme: $new_theme (restarted)" || echo "glava theme set to $new_theme (will apply on start)"
}

glava_status() {
    echo "glava running=$(_glava_is_running && echo yes || echo no) mode=$(_glava_get_mode) theme=$(_glava_get_theme)"
}

start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "sworddeck already running (PID $(cat "$PID_FILE")). Use restart."
        exit 0
    fi

    # Render graph if needed
    [ -f "$CFG_DIR/graph.json" ] || cp "$HERE/graph.default.json" "$CFG_DIR/graph.json"
    [ -f "$HERE/graph-render.sh" ] && "$HERE/graph-render.sh" > "$CFG_DIR/graph-render.log" 2>&1 || true

    # Init default state files
    [ -f "$GLAVA_MODE_FILE" ] || echo "graph" > "$GLAVA_MODE_FILE"
    [ -f "$GLAVA_THEME_FILE" ] || echo "cyan" > "$GLAVA_THEME_FILE"

    # Try C++ binary first, fall back to Python
    BIN=""
    if command -v sworddeck >/dev/null 2>&1; then
        BIN="sworddeck"
    elif [ -x "$HERE/cpp-sworddeck/build/sworddeck" ]; then
        BIN="$HERE/cpp-sworddeck/build/sworddeck"
    elif [ -x "$HERE/cyberdeck.py" ]; then
        BIN="python3 $HERE/cyberdeck.py"
    else
        echo "Error: no sworddeck binary found"
        exit 1
    fi

    # Launch GLava with saved settings
    GLAVA=0
    if command -v glava >/dev/null; then
        _restart_glava
        _glava_is_running && GLAVA=1
    fi

    # Launch
    CYBERDECK_GLAVA=0 nohup $BIN > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "sworddeck started (PID $!, backend=$(echo $BIN | awk '{print $NF}'), glava=$GLAVA)"
}

stop() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        kill "$pid" 2>/dev/null && echo "sworddeck stopped (PID $pid)" || echo "already dead"
        rm -f "$PID_FILE"
    else
        pkill -f "sworddeck" 2>/dev/null && echo "stopped" || echo "not running"
    fi
    if [ -f "$GLAVA_PID_FILE" ]; then
        kill "$(cat "$GLAVA_PID_FILE")" 2>/dev/null
        rm -f "$GLAVA_PID_FILE"
    fi
    pkill -x glava 2>/dev/null
    pkill xwinwrap 2>/dev/null
}

toggle_glava() {
    if _glava_is_running; then
        kill "$(cat "$GLAVA_PID_FILE")" 2>/dev/null
        rm -f "$GLAVA_PID_FILE"
        pkill -x glava 2>/dev/null
        echo "glava stopped"
    else
        if command -v glava >/dev/null; then
            _restart_glava
            echo "glava started (PID $(cat "$GLAVA_PID_FILE"))"
        else
            echo "glava not installed"
        fi
    fi
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "running (PID $(cat "$PID_FILE"))"
    else
        echo "not running"
    fi
}

case "${1:-start}" in
    start)        start ;;
    stop)         stop ;;
    restart)      stop; sleep 1; start ;;
    status)       status ;;
    edit)         "$HERE/graph-edit.sh" 2>/dev/null || echo "graph-edit.sh not found" ;;
    glava-toggle) toggle_glava ;;
    glava-mode)   glava_mode "${2:-}" ;;
    glava-theme)  glava_theme "${2:-}" ;;
    glava-status) glava_status ;;
    *) echo "Usage: sworddeck [start|stop|restart|status|edit|glava-toggle|glava-mode [graph|bars|wave|radial]|glava-theme [cyan|green|purple|red|rainbow|sunset]|glava-status]"; exit 1 ;;
esac
